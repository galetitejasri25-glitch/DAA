
#include <iostream>
#include <algorithm>
using namespace std;

struct Job {
    char id;
    int deadline, profit;
};

bool compare(Job a, Job b) {
    return a.profit > b.profit;
}

int main() {
    int n;
    cin >> n;

    Job jobs[100];

    for (int i = 0; i < n; i++) {
        cin >> jobs[i].id
            >> jobs[i].deadline
            >> jobs[i].profit;
    }

    sort(jobs, jobs + n, compare);

    int slot[100] = {0};
    char result[100];
    int maxDeadline = 0;
    int totalProfit = 0;

    for (int i = 0; i < n; i++)
        maxDeadline = max(maxDeadline, jobs[i].deadline);

    for (int i = 0; i < n; i++) {
        for (int j = min(maxDeadline, jobs[i].deadline) - 1;
             j >= 0; j--) {
            if (slot[j] == 0) {
                slot[j] = 1;
                result[j] = jobs[i].id;
                totalProfit += jobs[i].profit;
                break;
            }
        }
    }

    cout << "Selected Jobs: ";
    for (int i = 0; i < maxDeadline; i++) {
        if (slot[i])
            cout << result[i] << " ";
    }

    cout << "\nMaximum Profit = " << totalProfit;

    return 0;
}
