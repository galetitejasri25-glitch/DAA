
#include <iostream>
#include <stack>
using namespace std;

int main() {
    int n, a[100];
    cin >> n;

    for (int i = 0; i < n; i++)
        cin >> a[i];

    stack<int> st;
    int nge[100];

    for (int i = n - 1; i >= 0; i--) {
        while (!st.empty() && st.top() <= a[i])
            st.pop();

        if (st.empty())
            nge[i] = -1;
        else
            nge[i] = st.top();

        st.push(a[i]);
    }

    for (int i = 0; i < n; i++)
        cout << nge[i] << " ";

    return 0;
}
