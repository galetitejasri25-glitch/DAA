
#include <iostream>
#include <algorithm>
using namespace std;

struct Activity {
    int start, finish;
};

bool compare(Activity a, Activity b) {
    return a.finish < b.finish;
}

int main() {
    int n;
    cin >> n;

    Activity a[100];

    for (int i = 0; i < n; i++) {
        cin >> a[i].start >> a[i].finish;
    }

    sort(a, a + n, compare);

    cout << "Selected Activities: ";

    int lastFinish = -1;

    for (int i = 0; i < n; i++) {
        if (a[i].start >= lastFinish) {
            cout << "(" << a[i].start
                 << "," << a[i].finish << ") ";
            lastFinish = a[i].finish;
        }
    }

    return 0;
}
