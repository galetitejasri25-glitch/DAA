
#include <iostream>
using namespace std;

struct Node {
    int data;
    Node* next;
};

bool detectCycle(Node* head) {
    Node* slow = head;
    Node* fast = head;

    while (fast != NULL && fast->next != NULL) {
        slow = slow->next;
        fast = fast->next->next;

        if (slow == fast)
            return true;
    }

    return false;
}

int main() {
    Node* a = new Node{10, NULL};
    Node* b = new Node{20, NULL};
    Node* c = new Node{30, NULL};
    Node* d = new Node{40, NULL};

    a->next = b;
    b->next = c;
    c->next = d;

    d->next = b;  // Creates a cycle

    if (detectCycle(a))
        cout << "Cycle Detected";
    else
        cout << "No Cycle";

    return 0;
}
